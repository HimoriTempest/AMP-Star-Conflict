Meta.DisplayName=Star Conflict
Meta.Description=Star Conflict self-hosted server (Hub + cloud services + MongoDB). On Windows the game runs natively with its bundled MongoDB 2.6; on Linux it runs under Wine with MongoDB 3.4.
Meta.OS=Windows, Linux
Meta.AarchSupport=Emulated
Meta.Arch=All
Meta.Author=Himori, Shinynecrid
Meta.URL=https://store.steampowered.com/app/212070/Star_Conflict/
Meta.DisplayImageSource=steam:212070
Meta.EndpointURIFormat={ip}:{GenericModule.App.Ports.$LoadBalancerPort}
Meta.ConfigManifest=star-conflictconfig.json
Meta.MetaConfigManifest=star-conflictmetaconfig.json
Meta.ConfigRoot=star-conflict.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.ContainerPolicy=SupportedOnWindows, RequiredOnLinux
Meta.ContainerPolicyReason=On Linux the server is a Windows build that runs under Wine (64-bit with 32-bit support). The container image provides a known-good Wine, so on Linux the template always runs in a container. On Windows it runs natively.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.ConfigVersion=2.7.0
Meta.ReleaseNotes=Adds Windows support: the game runs natively with a PowerShell wrapper that starts MongoDB and Hub, streams the Hub log to the console, stops Hub, the services and MongoDB in order, and pins the database names so a different Windows user no longer starts fresh databases. The AMP settings (XP, credits, battle pass, shop options) are not applied on Windows yet.
Meta.AppConfigId=82c00331-b77e-4d56-8183-25ded7b67dc8
App.DisplayName=Star Conflict
App.RootDir=./star-conflict/
App.BaseDirectory=./star-conflict/instance/
App.ExecutableWin=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
App.ExecutableLinux=/bin/bash
App.WorkingDir=instance/server/cloud
App.LinuxCommandLineArgs="{{$FullRootDir}}hub-wrapper.sh"
App.WindowsCommandLineArgs=-NoProfile -ExecutionPolicy Bypass -File "{{$FullRootDir}}hub-wrapper.ps1"
App.CommandLineArgs={{$PlatformArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all","WINEDLLOVERRIDES":"mscoree,mshtml="}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitMethodWindows=String
App.ExitTimeout=120
App.ExitString=quit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJSON[star-conflictports.json]
App.AdminPortRef=
App.PrimaryApplicationPortRef=LoadBalancerPort
App.MaxUsers=800
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.AdminMethod=None
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=15
App.RCONConnectRetrySeconds=15
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJSON[star-conflictupdates.json]
App.PreStartStages=@IncludeJSON[star-conflictstart.json]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SupportsUniversalSleep=False
App.ApplicationReadyMode=RegexMatch
App.MonitorChildProcess=False
App.MonitorChildProcessName=
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(Could not find Wine Gecko.*|.*fixme:.*)$
Console.AppReadyRegex=^.*\| Hub: Connectee at .+ registered itself as 810000000000001$
Console.UserJoinRegex=^\[AMP\] Player joined: (?<username>.+) \(uid (?<userid>\d+)\)$
Console.UserLeaveRegex=^\[AMP\] Player left: (?<username>.+) \(uid (?<userid>\d+)\)$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=^\[AMP\] Stats: accounts (?<Registered_Accounts>\d+), cpu (?<Server_CPU_Percent>[\d.]+)%, memory (?<Server_Memory_MB>\d+) MB$
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.AutoRetryCount=2
